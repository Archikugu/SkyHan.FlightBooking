<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow+Condensed:wght@300;400;600;700&family=Barlow:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/geair/assets/css/flight-status.css">

<!-- Flight Status Area -->
<div class="brand-area brand-bg" id="flight-status">
    <div class="fsd-glow-left"></div>
    <div class="container fsd-container">

        <!-- Header -->
        <div class="fsd-header">
            <div class="fsd-title-block">
                <div class="fsd-eyebrow">Gerçek Zamanlı Bilgi</div>
                <h2 class="fsd-title">Uçuş Bilgi Ekranı</h2>
            </div>
            <div class="fsd-live-badge">
                <span class="fsd-live-dot"></span>
                Canlı Güncellemeler
            </div>
        </div>

        <!-- Tabs -->
        <div class="fsd-tabs" role="tablist">
            <button class="fsd-tab-btn active" data-tab="departures" role="tab" aria-selected="true">
                <i class="bi bi-airplane-fill" style="transform:rotate(45deg)"></i>
                Gidiş
            </button>
            <button class="fsd-tab-btn" data-tab="arrivals" role="tab" aria-selected="false">
                <i class="bi bi-airplane-fill" style="transform:rotate(135deg)"></i>
                Geliş
            </button>
        </div>

        <!-- Stats bar -->
        <div class="fsd-stats" id="fsd-stats-bar">
            <!-- filled by JS -->
        </div>

        <!-- ── DEPARTURES PANE ── -->
        <div class="fsd-pane active" id="pane-departures">
            <div class="fsd-table-wrap">
                <!-- Column headers -->
                <div class="fsd-col-headers">
                    <div class="fsd-col-label">Havayolu</div>
                    <div class="fsd-col-label">Uçuş</div>
                    <div class="fsd-col-label">Kalkış</div>
                    <div class="fsd-col-label">Varış</div>
                    <div class="fsd-col-label">Planlanan</div>
                    <div class="fsd-col-label">Kapı</div>
                    <div class="fsd-col-label">Terminal</div>
                    <div class="fsd-col-label">Durum</div>
                </div>
                <!-- Rows generated by JS -->
                <div id="departures-list"></div>
            </div>
        </div>

        <!-- ── ARRIVALS PANE ── -->
        <div class="fsd-pane" id="pane-arrivals">
            <div class="fsd-table-wrap">
                <div class="fsd-col-headers">
                    <div class="fsd-col-label">Havayolu</div>
                    <div class="fsd-col-label">Uçuş</div>
                    <div class="fsd-col-label">Kalkış</div>
                    <div class="fsd-col-label">Varış</div>
                    <div class="fsd-col-label">Planlanan</div>
                    <div class="fsd-col-label">Kapı</div>
                    <div class="fsd-col-label">Terminal</div>
                    <div class="fsd-col-label">Durum</div>
                </div>
                <div id="arrivals-list"></div>
            </div>
        </div>

        <!-- Ticker -->
        <div class="fsd-ticker-wrap">
            <div class="fsd-ticker-label"><i class="bi bi-broadcast me-1"></i>Güncellemeler</div>
            <div class="fsd-ticker-track">
                <div class="fsd-ticker-inner" id="fsd-ticker">
                    <!-- filled by JS -->
                </div>
            </div>
        </div>

    </div><!-- /.container -->
</div>
<!-- /.flight-status-area -->

<script src="~/geair/assets/js/flight-status.js"></script>