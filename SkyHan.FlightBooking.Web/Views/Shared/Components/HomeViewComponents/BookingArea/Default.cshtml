<!-- booking-area -->
﻿@await Component.InvokeAsync("BookingTags")

<link href="~/geair/assets/css/booking-widget.css" rel="stylesheet" />

<div class="booking-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="bk-widget">

                    <!-- TABS -->
                    <div class="bk-tabs" id="bkTabs">
                        <button class="bk-tab-btn active" data-tab="search">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /></svg>
                            Uçuş Ara
                        </button>
                        <button class="bk-tab-btn" data-tab="trips">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                            Seyahatlerim
                        </button>
                        <button class="bk-tab-btn" data-tab="checkin">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg>
                            Online Check-in
                        </button>
                        <button class="bk-tab-btn" data-tab="status">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                            Uçuş Durumu
                        </button>
                    </div>

                    <!-- PANEL -->
                    <div class="bk-panel">

                        <!-- ===================== UÇUŞ ARA ===================== -->
                        <div class="bk-pane active" id="pane-search">

                            <!-- Trip Type -->
                            <div class="trip-type-row" id="tripTypeRow">
                                <button class="trip-type-btn active" onclick="setTripType(this,'roundtrip')">Gidiş - Dönüş</button>
                                <button class="trip-type-btn" onclick="setTripType(this,'oneway')">Tek Yön</button>
                                <button class="trip-type-btn" onclick="setTripType(this,'multi')">Çoklu Uçuş</button>
                            </div>

                            <!-- Route -->
                            <div class="route-row">
                                <div class="airport-field">
                                    <div class="airport-field-label">
                                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="3" /></svg>
                                        Nereden
                                    </div>
                                    <input class="airport-field-input" type="text" placeholder="İstanbul, Türkiye" id="fromAirport" autocomplete="off" />
                                    <div class="airport-field-sub" id="fromSub">IST — Tüm Havalimanları</div>
                                </div>
                                <button class="swap-btn" onclick="swapAirports()" title="Yer Değiştir">
                                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4" /></svg>
                                </button>
                                <div class="airport-field">
                                    <div class="airport-field-label">
                                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                                        Nereye
                                    </div>
                                    <input class="airport-field-input" type="text" placeholder="Londra, Birleşik Krallık" id="toAirport" autocomplete="off" />
                                    <div class="airport-field-sub" id="toSub">LHR — Heathrow Havalimanı</div>
                                </div>
                            </div>

                            <!-- Dates -->
                            <div class="dates-row">
                                <div class="date-field">
                                    <div class="date-field-label">
                                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                                        Gidiş Tarihi
                                    </div>
                                    <input class="date-field-input" type="date" id="depDate" />
                                </div>
                                <div class="date-field" id="retDateField">
                                    <div class="date-field-label">
                                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                                        Dönüş Tarihi
                                    </div>
                                    <input class="date-field-input" type="date" id="retDate" />
                                </div>
                            </div>

                            <!-- Bottom row: Pax + Promo -->
                            <div class="bottom-row">
                                <div class="pax-trigger" id="paxTrigger" onclick="togglePax()" style="position:relative">
                                    <div class="pax-trigger-label">
                                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                                        Yolcu / Kabin Sınıfı
                                    </div>
                                    <div class="pax-trigger-value">
                                        <span id="paxSummary">1 Yetişkin — Ekonomi</span>
                                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                                    </div>
                                    <div class="pax-dropdown" id="paxDropdown" onclick="event.stopPropagation()">
                                        <div class="pax-row">
                                            <div>
                                                <div class="pax-info-title">Yetişkin</div>
                                                <div class="pax-info-sub">12 yaş ve üzeri</div>
                                            </div>
                                            <div class="pax-counter">
                                                <button class="pax-counter-btn" onclick="changePax('adult',-1)">−</button>
                                                <span class="pax-counter-val" id="adultCount">1</span>
                                                <button class="pax-counter-btn" onclick="changePax('adult',1)">+</button>
                                            </div>
                                        </div>
                                        <div class="pax-row">
                                            <div>
                                                <div class="pax-info-title">Çocuk</div>
                                                <div class="pax-info-sub">2–11 yaş</div>
                                            </div>
                                            <div class="pax-counter">
                                                <button class="pax-counter-btn" onclick="changePax('child',-1)">−</button>
                                                <span class="pax-counter-val" id="childCount">0</span>
                                                <button class="pax-counter-btn" onclick="changePax('child',1)">+</button>
                                            </div>
                                        </div>
                                        <div class="pax-row">
                                            <div>
                                                <div class="pax-info-title">Bebek</div>
                                                <div class="pax-info-sub">0–2 yaş</div>
                                            </div>
                                            <div class="pax-counter">
                                                <button class="pax-counter-btn" onclick="changePax('infant',-1)">−</button>
                                                <span class="pax-counter-val" id="infantCount">0</span>
                                                <button class="pax-counter-btn" onclick="changePax('infant',1)">+</button>
                                            </div>
                                        </div>
                                        <div class="cabin-section">
                                            <div class="cabin-section-label">Kabin Sınıfı</div>
                                            <div class="cabin-options" id="cabinOptions">
                                                <button class="cabin-btn active" onclick="selectCabin(this,'Ekonomi')">Ekonomi</button>
                                                <button class="cabin-btn" onclick="selectCabin(this,'Premium Ekonomi')">Premium Ekonomi</button>
                                                <button class="cabin-btn" onclick="selectCabin(this,'Business')">Business</button>
                                            </div>
                                        </div>
                                        <button class="pax-done-btn" onclick="closePax()">Tamam</button>
                                    </div>
                                </div>

                                <div class="promo-field">
                                    <div class="promo-field-label">
                                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" /><line x1="7" y1="7" x2="7.01" y2="7" /></svg>
                                        Promosyon
                                    </div>
                                    <div class="promo-toggle">
                                        <a class="promo-toggle-link" onclick="togglePromo(this)">
                                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                                            Promosyon Kodu Kullan
                                        </a>
                                    </div>
                                    <div class="promo-input-wrap" id="promoInputWrap">
                                        <input class="promo-input" type="text" placeholder="Kod girin (örn: YAZA25)" id="promoCode" />
                                    </div>
                                </div>
                            </div>

                            <!-- Extras -->
                            <div class="extras-row">
                                <label class="extra-check">
                                    <input type="checkbox" id="directOnly" /> Yalnızca Direkt Uçuşlar
                                </label>
                                <label class="extra-check">
                                    <input type="checkbox" id="flexDates" /> Esnek Tarihler
                                </label>
                                <label class="extra-check">
                                    <input type="checkbox" id="priceAlert" /> Fiyat Takvimi Göster
                                </label>
                            </div>

                            <!-- CTA -->
                            <button class="search-btn">
                                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                                Uçuşları Listele
                            </button>
                        </div>


                        <!-- ===================== SEYAHATLERİM ===================== -->
                        <div class="bk-pane" id="pane-trips">
                            <div class="bk-section-header">
                                <h3 class="bk-section-title">Seyahatlerim</h3>
                                <p class="bk-section-sub">Rezervasyon bilgilerinizle mevcut veya geçmiş seyahatlerinize erişin.</p>
                            </div>

                            <div class="query-method-row" id="tripMethodRow">
                                <button class="query-method-btn active" onclick="setQueryMethod('trips','pnr',this)">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M7 8h10M7 12h6" /></svg>
                                    PNR ile Sorgula
                                </button>
                                <button class="query-method-btn" onclick="setQueryMethod('trips','ticket',this)">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z" /></svg>
                                    Bilet No ile Sorgula
                                </button>
                                <button class="query-method-btn" onclick="setQueryMethod('trips','email',this)">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                                    E-posta ile Sorgula
                                </button>
                            </div>

                            <div class="query-fields active" id="trips-pnr">
                                <div class="field-stack">
                                    <div class="two-col">
                                        <div class="input-field-wrap">
                                            <div class="input-field-label">Rezervasyon Kodu (PNR)</div>
                                            <input class="input-field" type="text" placeholder="6 haneli kod, örn: ABC123" style="text-transform:uppercase;" />
                                        </div>
                                        <div class="input-field-wrap">
                                            <div class="input-field-label">Soyad</div>
                                            <input class="input-field" type="text" placeholder="Bilet üzerindeki soyad" />
                                        </div>
                                    </div>
                                    <button class="search-btn" style="margin-top:4px">
                                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4" /></svg>
                                        Seyahatimi Görüntüle
                                    </button>
                                </div>
                            </div>

                            <div class="query-fields" id="trips-ticket">
                                <div class="field-stack">
                                    <div class="two-col">
                                        <div class="input-field-wrap">
                                            <div class="input-field-label">Bilet Numarası</div>
                                            <input class="input-field" type="text" placeholder="13 haneli bilet numarası" />
                                        </div>
                                        <div class="input-field-wrap">
                                            <div class="input-field-label">Soyad</div>
                                            <input class="input-field" type="text" placeholder="Bilet üzerindeki soyad" />
                                        </div>
                                    </div>
                                    <button class="search-btn" style="margin-top:4px">
                                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4" /></svg>
                                        Rezervasyonumu Bul
                                    </button>
                                </div>
                            </div>

                            <div class="query-fields" id="trips-email">
                                <div class="field-stack">
                                    <div class="input-field-wrap">
                                        <div class="input-field-label">E-posta Adresi</div>
                                        <input class="input-field" type="email" placeholder="Rezervasyonun yapıldığı e-posta" />
                                    </div>
                                    <button class="search-btn" style="margin-top:4px">
                                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4" /></svg>
                                        Rezervasyonumu Bul
                                    </button>
                                </div>
                            </div>

                            <div class="help-links">
                                <a href="#" class="help-link">
                                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                                    PNR kodumu bilmiyorum
                                </a>
                                <a href="#" class="help-link">
                                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                    Rezervasyon değişikliği
                                </a>
                                <a href="#" class="help-link">
                                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v6M14 11v6" /></svg>
                                    İade / İptal işlemleri
                                </a>
                            </div>
                        </div>


                        <!-- ===================== CHECK-IN ===================== -->
                        <div class="bk-pane" id="pane-checkin">
                            <div class="bk-section-header">
                                <h3 class="bk-section-title">Online Check-in</h3>
                                <p class="bk-section-sub">Uçuş saatinizden en fazla 24 saat, en az 1 saat önce online check-in yapabilirsiniz.</p>
                            </div>

                            <div class="info-cards">
                                <div class="info-card">
                                    <div class="info-card-icon">
                                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
                                    </div>
                                    <div>
                                        <div class="info-card-title">Koltuk Seçimi</div>
                                        <div class="info-card-sub">Tercih ettiğiniz koltuğu seçin</div>
                                    </div>
                                </div>
                                <div class="info-card">
                                    <div class="info-card-icon">
                                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8" /><polyline points="3.29 7 12 12 20.71 7" /><line x1="12" y1="22" x2="12" y2="12" /></svg>
                                    </div>
                                    <div>
                                        <div class="info-card-title">Bagaj Bilgisi</div>
                                        <div class="info-card-sub">İzin verilen bagaj miktarı</div>
                                    </div>
                                </div>
                                <div class="info-card">
                                    <div class="info-card-icon">
                                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2" /><line x1="12" y1="18" x2="12.01" y2="18" /></svg>
                                    </div>
                                    <div>
                                        <div class="info-card-title">Mobil Biniş Kartı</div>
                                        <div class="info-card-sub">Telefona indirin, kağıtsız uçun</div>
                                    </div>
                                </div>
                            </div>

                            <div class="bk-notice">
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                                Check-in işlemi uçuş saatinden <strong>24 saat önce</strong> başlar. Koltuk seçimi ve mobil biniş kartı işlemlerinizi tamamlayın.
                            </div>

                            <div class="query-method-row" id="ciMethodRow">
                                <button class="query-method-btn active" onclick="setQueryMethod('ci','pnr',this)">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M7 8h10M7 12h6" /></svg>
                                    PNR + Soyad
                                </button>
                                <button class="query-method-btn" onclick="setQueryMethod('ci','ticket',this)">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z" /></svg>
                                    Bilet No + Soyad
                                </button>
                            </div>

                            <div class="query-fields active" id="ci-pnr">
                                <div class="two-col" style="margin-bottom:16px">
                                    <div class="input-field-wrap">
                                        <div class="input-field-label">Rezervasyon Kodu (PNR)</div>
                                        <input class="input-field" type="text" placeholder="ABC123" style="text-transform:uppercase" />
                                    </div>
                                    <div class="input-field-wrap">
                                        <div class="input-field-label">Soyad</div>
                                        <input class="input-field" type="text" placeholder="Pasaport / kimlik üzerindeki soyad" />
                                    </div>
                                </div>
                                <button class="search-btn">
                                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                                    Check-in İşlemini Başlat
                                </button>
                            </div>

                            <div class="query-fields" id="ci-ticket">
                                <div class="two-col" style="margin-bottom:16px">
                                    <div class="input-field-wrap">
                                        <div class="input-field-label">Bilet Numarası</div>
                                        <input class="input-field" type="text" placeholder="13 haneli numara" />
                                    </div>
                                    <div class="input-field-wrap">
                                        <div class="input-field-label">Soyad</div>
                                        <input class="input-field" type="text" placeholder="Pasaport / kimlik üzerindeki soyad" />
                                    </div>
                                </div>
                                <button class="search-btn">
                                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                                    Check-in İşlemini Başlat
                                </button>
                            </div>
                        </div>


                        <!-- ===================== UÇUŞ DURUMU ===================== -->
                        <div class="bk-pane" id="pane-status">
                            <div class="bk-section-header">
                                <h3 class="bk-section-title">Uçuş Durumu</h3>
                                <p class="bk-section-sub">Anlık uçuş takibi için uçuş numarası veya rota ile sorgulayın.</p>
                            </div>

                            <div class="fs-method-row">
                                <button class="fs-method-btn active" onclick="setFsMethod('fno',this)">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21 4 21 4s-2 0-3.5 1.5L14 9 5.8 7.2l-1.3 1.3 6.9 3.6-2.4 2.4-2.6-.5-1.2 1.2 3.5 1.5 1.5 3.5 1.2-1.2-.5-2.6 2.4-2.4 3.6 6.9 1.3-1.3z" /></svg>
                                    Uçuş Numarası
                                </button>
                                <button class="fs-method-btn" onclick="setFsMethod('route',this)">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
                                    Rota Bazlı Arama
                                </button>
                            </div>

                            <div class="query-fields active" id="fs-fno">
                                <div class="two-col" style="margin-bottom:16px">
                                    <div class="input-field-wrap">
                                        <div class="input-field-label">Uçuş Numarası</div>
                                        <input class="input-field" type="text" placeholder="Örn: TK1234" style="text-transform:uppercase" />
                                    </div>
                                    <div class="input-field-wrap">
                                        <div class="input-field-label">Tarih</div>
                                        <input class="input-field" type="date" />
                                    </div>
                                </div>
                                <button class="search-btn" style="margin-bottom:0">
